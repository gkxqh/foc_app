<?xml version="1.0" encoding="utf-8"?>
<!-- 技术员工作台 4x2：头部余量 + 两条在手单 + 扫码/刷新 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tech_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_tech_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tech_page_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="@string/widget_page_prev"
            android:textSize="15sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/tech_page_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_text_tertiary" />

        <TextView
            android:id="@+id/tech_page_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="@string/widget_page_next"
            android:textSize="15sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <!-- 未登录 / 登录过期引导 -->
    <LinearLayout
        android:id="@+id/tech_block_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tech_off_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/tech_off_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="4dp"
            android:text="@string/widget_open_app"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/tech_block_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_tech_empty"
        android:textSize="12sp"
        android:textColor="@color/widget_text_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tech_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tech_row1"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tech_row1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/tech_row1_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tech_row2"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tech_row2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/tech_row2_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/tech_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tech_btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_accent"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_btn_scan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tech_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:textSize="10sp"
            android:textColor="@color/widget_text_tertiary" />

        <TextView
            android:id="@+id/tech_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_ghost"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_btn_refresh"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
</LinearLayout>
