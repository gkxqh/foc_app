<?xml version="1.0" encoding="utf-8"?>
<!-- 我的报修 4x2：最新进行中单 + 四步进度 + 待确认直达 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/user_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_user_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <!-- 未登录 / 登录过期引导 -->
    <LinearLayout
        android:id="@+id/user_block_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/user_off_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/user_off_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="4dp"
            android:text="@string/widget_open_app"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent" />
    </LinearLayout>

    <!-- 空态：直接给报修入口 -->
    <LinearLayout
        android:id="@+id/user_block_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_user_empty"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/user_btn_report_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_chip_accent"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_btn_report"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_bg" />
    </LinearLayout>

    <!-- 内容态：最新一条进行中工单 -->
    <LinearLayout
        android:id="@+id/user_block_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/user_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/user_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/user_confirm_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_accent"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/widget_btn_confirm"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_bg"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 四步进度：报修 · 接单 · 确认 · 完成（与 App 工单详情页步骤条一致） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/user_step1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_step_report"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/user_sep1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/widget_step_sep"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/user_step2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_step_accept"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/user_sep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/widget_step_sep"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/user_step3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_step_confirm"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/user_sep3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/widget_step_sep"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/user_step4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_step_done"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/user_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/user_btn_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_ghost"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_btn_report"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/user_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:textSize="10sp"
            android:textColor="@color/widget_text_tertiary" />

        <TextView
            android:id="@+id/user_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_ghost"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_btn_refresh"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
</LinearLayout>
